{
  "name": "kujira",
  "version": "0.1.0",
  "description": "DeepSeek Harness × QQ 官方 Bot API v2 合规单聊（C2C）拟人化聊天插件：既是随叫随到的专业助手，也是能记事实、懂梗玩词的贴心伙伴。内置双层记忆、表情资产库、黑话知识库、Markdown/流式回复与 WebUI 可视化配置",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/plugin.d.ts",
      "default": "./dist/tools/plugin.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "package.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiangsubei/kujira.git"
  },
  "bugs": {
    "url": "https://github.com/Jiangsubei/kujira/issues"
  },
  "homepage": "https://github.com/Jiangsubei/kujira#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.2-0"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run check:privacy",
    "build": "tsx scripts/sync-patch.ts && tsc && npm run build:client",
    "build:client": "tsx scripts/build-client.ts",
    "sync:patch": "tsx scripts/sync-patch.ts",
    "dev": "pnpm run build && tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm run build && vitest run",
    "test:quick": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.test.json",
    "check:privacy": "tsx scripts/privacy-guard.ts",
    "probe:qq": "tsx scripts/probe-qq.ts",
    "probe:active": "tsx scripts/probe-active-message.ts",
    "probe:e3": "tsx scripts/probe-e3-length.ts",
    "probe:quote": "tsx scripts/probe-quote.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "qq",
    "qq-bot",
    "c2c",
    "kujira",
    "cordis"
  ],
  "author": "Jiangsubei",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.1.0",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-0",
    "@deepseek-ai/dsh-agent-instructions": ">=0.2.2-0",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-0",
    "@deepseek-ai/dsh-base": ">=0.2.2-0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.2-0",
    "@deepseek-ai/dsh-persona": ">=0.2.2-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-0",
    "@deepseek-ai/dsh-storage": ">=0.2.2-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-0",
    "@deepseek-ai/dsh-storage-json": ">=0.2.2-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-ask-user": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-bash": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-pwsh": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-skill": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-web": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-working-directory": ">=0.2.2-0",
    "@deepseek-ai/dsh-tool-workspace-dependencies": ">=0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.2-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
